APP_NAME=RuanGao Note
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/ruangao_note.db
STORAGE_DIR=./data/uploads
MAX_IMAGE_BYTES=20971520
MAX_BATCH_UPLOAD_BYTES=314572800
MAX_BATCH_UPLOAD_COUNT=30
MAX_IMAGE_PIXELS=60000000

# MinerU v4 cloud API. Put your real token only in the local .env file.
MINERU_TOKEN=
MINERU_API_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_MAX_WAIT_SECONDS=1500
# Optional HTTP(S) proxy for result ZIP downloads. Leave empty for direct connection.
MINERU_DOWNLOAD_PROXY=
